# Copia estas variables a backend/.env sin reemplazar su contenido existente.
# Cambia disabled por sandbox solo después de completar las CUATRO credenciales test.
# No uses llaves de producción. No copies estos valores al frontend ni a Git.
WOMPI_MODE=disabled
WOMPI_PUBLIC_KEY=pub_test_REPLACE_WITH_YOUR_SANDBOX_KEY
WOMPI_PRIVATE_KEY=prv_test_REPLACE_WITH_YOUR_SANDBOX_KEY
WOMPI_INTEGRITY_SECRET=test_integrity_REPLACE_WITH_YOUR_SANDBOX_SECRET
WOMPI_EVENTS_SECRET=test_events_REPLACE_WITH_YOUR_SANDBOX_SECRET
WOMPI_REDIRECT_URL=http://localhost:5173/me/orders
